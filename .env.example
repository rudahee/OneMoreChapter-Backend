# Copiar a .env y rellenar. .env esta en .gitignore.
# La sintaxis ${VAR:?...} del compose aborta el arranque si falta alguna,
# en vez de levantar los servicios con valores vacios.

# --- Base de datos ---
DB_NAME=uncapitulomas
DB_USER=uncapitulomas
# openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis ---
# openssl rand -base64 24
REDIS_PASSWORD=

# --- Aplicacion ---
# Minimo 32 caracteres. HS256 exige 256 bits y Nimbus falla al arrancar si es
# mas corta:  openssl rand -base64 48
JWT_SECRET=

# Obligatorio y con contacto real. Wikidata devuelve resultados vacios sin un
# User-Agent identificable y puede bloquear la IP.
METADATA_USER_AGENT=UnCapituloMas/1.0 (+https://lista.tudominio.es; tu@correo.es)

APP_HOST=lista.tudominio.es
APP_VERSION=latest
