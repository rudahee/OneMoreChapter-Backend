# Catalogo de versiones. Todas las versiones viven aqui y build.gradle.kts solo
# referencia alias: evita que el mismo artefacto acabe con dos versiones en
# modulos distintos y hace que Dependabot o Renovate lo actualicen solos.

[versions]
springBoot = "4.1.1"                    # ago 2026, sobre Spring Framework 7
dependencyManagement = "1.1.7"
springdoc = "3.1.1"                     # la serie 3.x es la de Spring Boot 4
bucket4j = "8.19.0"                     # may 2026
wiremock = "3.13.1"                     # verificar la ultima antes de fijarla

[libraries]
# --- Web y validacion ---
spring-boot-starter-web = { module = "org.springframework.boot:spring-boot-starter-web" }
spring-boot-starter-validation = { module = "org.springframework.boot:spring-boot-starter-validation" }
spring-boot-starter-websocket = { module = "org.springframework.boot:spring-boot-starter-websocket" }

# --- Seguridad ---
spring-boot-starter-security = { module = "org.springframework.boot:spring-boot-starter-security" }
# Aporta JwtEncoder y JwtDecoder sobre Nimbus. Evita meter jjwt como
# dependencia extra y usa las abstracciones que Spring Security ya entiende.
spring-boot-starter-oauth2-resource-server = { module = "org.springframework.boot:spring-boot-starter-oauth2-resource-server" }

# --- Persistencia ---
spring-boot-starter-data-jpa = { module = "org.springframework.boot:spring-boot-starter-data-jpa" }
flyway-core = { module = "org.flywaydb:flyway-core" }
# Desde Flyway 10 el soporte por motor va en modulos aparte. Sin esto, Flyway
# arranca y falla diciendo que no reconoce la base de datos.
flyway-mysql = { module = "org.flywaydb:flyway-mysql" }
mariadb-client = { module = "org.mariadb.jdbc:mariadb-java-client" }

# --- Cache ---
spring-boot-starter-data-redis = { module = "org.springframework.boot:spring-boot-starter-data-redis" }
spring-boot-starter-cache = { module = "org.springframework.boot:spring-boot-starter-cache" }

# --- Observabilidad ---
spring-boot-starter-actuator = { module = "org.springframework.boot:spring-boot-starter-actuator" }
micrometer-prometheus = { module = "io.micrometer:micrometer-registry-prometheus" }

# --- Terceros ---
bucket4j-core = { module = "com.bucket4j:bucket4j_jdk17-core", version.ref = "bucket4j" }
springdoc-webmvc-ui = { module = "org.springdoc:springdoc-openapi-starter-webmvc-ui", version.ref = "springdoc" }

# --- Utilidades de compilacion ---
lombok = { module = "org.projectlombok:lombok" }
spring-boot-configuration-processor = { module = "org.springframework.boot:spring-boot-configuration-processor" }

# --- Test ---
spring-boot-starter-test = { module = "org.springframework.boot:spring-boot-starter-test" }
spring-boot-testcontainers = { module = "org.springframework.boot:spring-boot-testcontainers" }
spring-security-test = { module = "org.springframework.security:spring-security-test" }
testcontainers-junit = { module = "org.testcontainers:junit-jupiter" }
testcontainers-mariadb = { module = "org.testcontainers:mariadb" }
wiremock = { module = "org.wiremock:wiremock-standalone", version.ref = "wiremock" }

[plugins]
spring-boot = { id = "org.springframework.boot", version.ref = "springBoot" }
dependency-management = { id = "io.spring.dependency-management", version.ref = "dependencyManagement" }